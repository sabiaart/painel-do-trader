{
  // Diz ao Cloudflare exatamente o que publicar, em vez de deixar ele adivinhar.
  // "directory" e a pasta que vira o site. Tudo fora dela (pipeline, prototipo,
  // documentos) fica no GitHub mas nao vai para o ar.
  "name": "painel-do-trader",
  "compatibility_date": "2026-11-01",

  // A trava de senha. Ver worker/index.js.
  "main": "worker/index.js",

  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",

    // Liga a pasta do site ao codigo, para o Worker poder entregar as
    // paginas depois de conferir a senha.
    "binding": "ASSETS",

    // ESSENCIAL: sem isto, o Cloudflare entrega os arquivos direto e o
    // Worker nunca e chamado - ou seja, a senha nao protegeria nada.
    "run_worker_first": true
  }
}
